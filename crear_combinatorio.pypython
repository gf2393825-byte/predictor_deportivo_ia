    f.write('''import sqlite3\nimport itertools\nfrom config.settings import settings\nfrom src.models.dixon_coles import calcular_probabilidades_partido\nfrom src.progol.optimizer import evaluar_valor_partido, filtrar_quiniela_valida\n\ndef cargar_partidos_jornada(numero_jornada):\n    conn = sqlite3.connect(settings.DB_PATH)\n    cursor = conn.cursor()\n    query = """\n    SELECT \n        p.id,\n        e_loc.nombre as local,\n        e_vis.nombre as visitante,\n        m.local_xg,\n        m.visitante_xg,\n        pj.pct_local_publico,\n        pj.pct_empate_publico,\n        pj.pct_visitante_publico\n    FROM progol_jornadas pj\n    JOIN partidos p ON pj.partido_id = p.id\n    JOIN equipos e_loc ON p.equipo_local_id = e_loc.id\n    JOIN equipos e_vis ON p.equipo_visitante_id = e_vis.id\n    JOIN metricas_avanzadas m ON p.id = m.partido_id\n    WHERE pj.numero_jornada = ?\n    """\n    cursor.execute(query, (numero_jornada,))\n    filas = cursor.fetchall()\n    conn.close()\n    return filas\n\ndef generar_quiniela_optimizada(numero_jornada):\n    partidos = cargar_partidos_jornada(numero_jornada)\n    if not partidos:\n        print(f"No se encontraron partidos para la jornada {numero_jornada}.")\n        return\n    print(f"=== ANALISIS COMBINATORIO PROGOL - JORNADA {numero_jornada} ===")\n    quiniela_base = []\n    for p in partidos:\n        p_id, loc, vis, xg_l, xg_v, pct_l, pct_e, pct_v = p\n        probs = calcular_probabilidades_partido(xg_l, xg_v)\n        ev_l = evaluar_valor_partido(probs["prob_local"], pct_l)\n        ev_e = evaluar_valor_partido(probs["prob_empate"], pct_e)\n        ev_v = evaluar_valor_partido(probs["prob_visitante"], pct_v)\n        oppciones = [("1", ev_l), ("X", ev_e), ("2", ev_v)]\n        opciones_ordenadas = sorted(oppciones, key=lambda x: x[1], reverse=True)\n        quiniela_base.append({\n            "partido": f"{loc} vs {vis}",\n            "fijo": opciones_ordenadas[0][0],\n            "ev_top": opciones_ordenadas[0][1],\n            "doble_sugerido": [opciones_ordenadas[0][0], opciones_ordenadas[1][0]]\n        })\n        print(f"{loc} vs {vis}")\n        print(f"  Probabilidades -> L: {probs[\'prob_local\']*100:.1f}%, E: {probs[\'prob_empate\']*100:.1f}%, V: {probs[\'prob_visitante\']*100:.1f}%")\n        print(f"  Indices EV     -> L: {ev_l}, E: {ev_e}, V: {ev_v}")\n        print(f"  Sugerencia     -> Fijo: {opciones_ordenadas[0][0]} | Doble: {\'\'.join([opciones_ordenadas[0][0], opciones_ordenadas[1][0]])}")\n        print("-" * 50)\n    return quiniela_base\n\nif __name__ == "__main__":\n    generar_quiniela_optimizada(2250)\n''')  crear_combinatorio.py
